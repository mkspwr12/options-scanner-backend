# -----------------------------------------------------------------------
# Options Scanner Backend — Environment Variables
# -----------------------------------------------------------------------
# Copy this file to .env and fill in real values for local development.
# Azure App Service will have these set as Application Settings.
# -----------------------------------------------------------------------

# REQUIRED: Azure SQL connection string
# Format: Server=<server>.database.windows.net;Database=<db>;
SQL_CONNECTION_STRING=Server=your-server.database.windows.net;Database=options-scanner;

# Optional: Managed Identity client ID (leave blank for system-assigned)
AZURE_CLIENT_ID=

# ODBC driver name (default works for most Azure deployments)
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.azurewebsites.net

# API key for endpoint authentication (leave blank to disable auth)
API_KEY=

# Market data provider: "mock" (deterministic test data) or "yahoo_finance" (live)
MARKET_DATA_PROVIDER=mock

# Background scan interval in minutes (0 = disabled)
SCAN_INTERVAL_MINUTES=15
SCAN_ENABLED=true

# Rate limiting: max requests per minute per client IP (0 = disabled)
RATE_LIMIT_PER_MINUTE=60

# Circuit breaker: failures before opening, timeout before retrying (seconds)
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=300

# In-memory log retention count
LOG_RETENTION=1000

# Azure Application Insights (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=
